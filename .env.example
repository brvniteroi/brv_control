# Copie para .env e preencha (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_ANON_KEY

# Upload de fotos (hostgator-api/upload.php, publicado com o app em /api/ pelo deploy)
VITE_UPLOAD_URL=https://control.brvniteroi.com.br/api/upload.php

# Google Cloud > APIs e serviços > Credenciais. Ative "Maps JavaScript API" e "Geocoding API"
# e restrinja a chave por referenciador HTTP (localhost:5173 e o domínio do app).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDYxLtITEt2DdJRk8fbHNDbDlF5Y5lk1p0
# Opcional: Map ID (Google Cloud > Maps > Gerenciamento de mapas). Sem ele usa o ID de demonstração.
VITE_GOOGLE_MAPS_MAP_ID=
