# Pasta de fotos: nada aqui é executado, só servido como imagem.
# (Não usar "php_flag engine off": dá erro 500 quando o PHP roda como FPM/CGI.)
Options -Indexes -ExecCGI

<FilesMatch ".*">
  Require all denied
</FilesMatch>
# jpeg, mp4 e mov: fotos e vídeos importados do Field Control; pdf: termo TRT/ART e laudos do PMOC (só admin/escritório enviam)
<FilesMatch "\.(jpg|jpeg|png|webp|mp4|mov|pdf)$">
  Require all granted
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'"
  # Nome do arquivo é único e nunca é sobrescrito: pode cachear para sempre
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>

# O leitor de PDF do navegador não abre com a CSP "default-src 'none'": para PDF ela sai (o arquivo é servido como documento)
<FilesMatch "\.pdf$">
  <IfModule mod_headers.c>
    Header unset Content-Security-Policy
    Header set Content-Disposition "inline"
  </IfModule>
</FilesMatch>
