{
  "name": "brv-agente-impressora",
  "version": "1.0.0",
  "private": true,
  "description": "Agente da fila de impressão do BRV Control: pega as etiquetas da fila e envia para a Elgin L42PRO",
  "type": "module",
  "scripts": {
    "start": "node agente.mjs",
    "teste": "node agente.mjs --teste-local",
    "calibrar": "node agente.mjs --calibrar",
    "status": "node agente.mjs --status",
    "gravar-config": "node agente.mjs --gravar-config"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "engines": {
    "node": ">=22"
  }
}
